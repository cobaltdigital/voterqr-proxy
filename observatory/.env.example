# Copy to .env and fill in only the connectors you actually use.
# Credentials are read per call and never written to the database.

# Core
OBSERVATORY_DB=./data/observatory.db
OBSERVATORY_LOG_LEVEL=info
PORT=4000

# Set to 1 to force collectors to use fixtures instead of the network
# OBSERVATORY_OFFLINE=1

# Dev identity used when no x-observatory-* headers are sent
OBSERVATORY_DEV_ACTOR=dev@local
OBSERVATORY_DEV_ROLE=admin
# OBSERVATORY_DEV_CLIENTS=northside-dental

# ── Connector credentials (see: node bin/observatory.js connectors) ──────────
# PAGESPEED_API_KEY=            # optional; unkeyed requests are heavily rate limited
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GSC_REFRESH_TOKEN=
# GA4_PROPERTY_ID=
# GA4_REFRESH_TOKEN=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_REFRESH_TOKEN=
# GBP_ACCOUNT_ID=
# CRUX_API_KEY=
# CALLRAIL_API_KEY=
# CALLRAIL_ACCOUNT_ID=
# META_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=
# SOCIAL_API_TOKEN=
